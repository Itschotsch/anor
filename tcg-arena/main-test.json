{
  "name": "Anor",
  "menuBackgroundImage": "https://itschotsch.github.io/anor/tcg-arena/assets/banner.jpg",
  "deckBuilding": {
    "mainFilters": [
      "type",
      "Element",
      "cost"
    ],
    "formats": [
      {
        "title": "Klassisch",
        "gameplay": "Classic"
      }
    ]
  },
  "gameplay": {
    "Classic": {
      "beforeGameStart": {
        "initialBoardSetup":
          [
            {
              "drawFromTop": "Deck",
              "count": 3,
              "destination": "Siegel"
            }
          ]
      },
      "mulligan": {
        "startingHandSize": 8,
        "mulliganCount": {
          "max": 1
        },
        "mulliganCycle": {
          "info": "Du kannst 8 neue Karten ziehen. Deine alte Hand wird ins Deck gemischt.",
          "steps": ["toTop", "shuffle", "draw"],
          "selectionRange": {
            "min": 8,
            "max": 99
          }
        },
        "postMulligan": {
          "minMulligansToTrigger": 1,
          "info": "Lege eine Handkarte deiner Wahl unter das Deck.",
          "steps": ["toBottom"],
          "selectionRange": {
            "min": 1,
            "max": 1
          }
        }
      },
      "newTurn": {
        "drawOnStart": true,
        "sharedTurn": false
      },
      "countersStartingValues": [
        0,
        0
      ],
      "draggableTokens": [
              {
                  "id": "target",
                  "name": "Ziel",
                  "image": "https://itschotsch.github.io/anor/tcg-arena/assets/token-target.png"
              },
              {
                  "id": "bannkreis",
                  "name": "Bannkreis",
                  "image": "https://itschotsch.github.io/anor/tcg-arena/assets/token-bannkreis.png"
              }
      ],
      "sections": {
        "customSections": [
          "Feld",
          "Elementar",
          "Siegel"
        ],
        "layout": {
          "direction": "column",
          "content": [
            {
              "section": "Feld"
            },
            {
              "direction": "row",
              "content": [
                {
                  "section": "Elementar"
                },
                {
                  "section": "Siegel",
                  "style": {
                    "max-width": "18vw"
                  }
                }
              ]
            },
            {
              "section": "Aufbau"
            },
            {
              "section": "AufbauZaehler"
            }
          ]
        },
        "autoPlayFromHand": {
          "Charakter": "Feld",
          "Ereignis": "Stack",
          "Manifestation": "Feld"
        },
        "autoPlayFromStack": {
          "Charakter": "Feld",
          "Ereignis": "Discard",
          "Manifestation": "Feld"
        },
        "sectionsDict": {
          "Elementar": {
            "title": "Elementar",
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "START",
            "isHorizontalAllowed": false,
            "opponentAlignment": false,
            "noAutoPayTo": false,
            "displayedTitle": "",
            "noQuickActions": false,
            "enterTapped": true,
            "enterSpun": true,
            "isGroupForbidden": false,
            "keepTappedNewTurn": false,
            "showHiddenCardInHistory": false
          },
          "Feld": {
            "title": "Feld",
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER",
            "isHorizontalAllowed": false,
            "opponentAlignment": false,
            "noAutoPayTo": false,
            "displayedTitle": "",
            "noQuickActions": false,
            "enterTapped": false,
            "enterSpun": false,
            "isGroupForbidden": false,
            "keepTappedNewTurn": true,
            "showHiddenCardInHistory": false
          },
          "Siegel": {
            "title": "Siegel",
            "isHidden": "yes",
            "height": "SMALL",
            "alignment": "END",
            "isHorizontalAllowed": false,
            "opponentAlignment": false,
            "noAutoPayTo": false,
            "displayedTitle": "Siegel",
            "noQuickActions": true,
            "enterTapped": false,
            "enterSpun": false,
            "isGroupForbidden": true,
            "keepTappedNewTurn": true,
            "showHiddenCardInHistory": false
          },
            "Aufbau": {
              "type": "custom",
              "isShared": true,
              "defaultValue": {
                "current": 0
              },
              "blueprint": {
                "type": "div",
                "props": {
                  "className": "{{ game.data.Aufbau.current >= game.turn.totalPlayers ? 'd-none' : 'position-absolute top-0 start-0 box-container align-items-center text-nowrap gap-2 p-1 ps-2' }}"
                },
                "children": [
                  "{{ game.data.Aufbau.current < game.turn.totalPlayers ? 'Aufbau: Spieler ' + (game.data.Aufbau.current + 1) + ' legt 2 Handkarten als Elementarkarten (erschöpft) ab' : '' }}",
                  {
                    "type": "button",
                    "children": "Fertig",
                    "onClick": "if (game.turn.orderPosition === game.data.Aufbau.current && (cards.Elementar ?? []).length === 2) { game.data.Aufbau.current += 1; chatLog('hat die Elementarkarten gelegt') } else { chatLog('ist noch nicht an der Reihe oder hat nicht genau 2 Elementarkarten') }"
                  }
                ]
              },
              "events": {
                "onStart": "game.data.Aufbau.current = 0"
              }
            },
            "AufbauZaehler": {
              "type": "custom",
              "defaultValue": {
                "count": 0
              },
              "blueprint": {
                "type": "div",
                "props": {
                  "className": "{{ game.data.Aufbau.current >= game.turn.totalPlayers ? 'd-none' : 'position-absolute top-0 end-0 box-container text-nowrap p-1 px-2' }}"
                },
                "children": "Elementar: {{ game.data.AufbauZaehler.count }}/2"
              },
              "events": {
                "onCardsUpdate": "game.data.AufbauZaehler.count = (cards.Elementar ?? []).length"
              }
            }
        }
      },
      "defaultNotes": "",
      "tokens": [],
      "hideFacedDownCards": true
    },
    "Monarch": {
